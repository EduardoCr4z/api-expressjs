# docker-compose.j2
version: "3.8"
services:

  backend-node:
    build:
      context: .
      dockerfile: Dockerfile
    image: backend-node-{{ container_suffix }}
    ports:
      - "{{ backend_port }}:4000"
    env_file:
      - .env
    container_name: backend-node-{{ container_suffix }}
    networks:
      - backendnode-net
    restart: always

  mysql:
    image: mysql:8
    command: --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
    container_name: mysql_bd_{{ container_suffix }}
    ports:
      - "{{ mysql_port }}:3306"
    environment:
      MYSQL_ROOT_PASSWORD: 123456
      MYSQL_DATABASE: asignaciones
    volumes:
      - mysql_data_{{ container_suffix }}:/var/lib/mysql
      - ./script_bd.sql:/docker-entrypoint-initdb.d/script_bd.sql
    networks:
      - backendnode-net
    restart: always

networks:
  backendnode-net:
    driver: bridge

volumes:
  mysql_data_{{ container_suffix }}: