services:
  backend:
    build:
      context: ./backend_node
    container_name: backend_{{ instance_name }}
    restart: always
    env_file:
      - .env
    ports:
      - "9000:4000"
    depends_on:
      - mysql_prueba_instancia

  mysql_prueba_instancia:
    image: mysql:8
    container_name: mysql_{{ instance_name }}
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: 123456
      MYSQL_DATABASE: asignaciones
    volumes:
      - mysql_data:/var/lib/mysql
      - ./backend_node/script_bd.sql:/docker-entrypoint-initdb.d/script_bd.sql

volumes:
  mysql_data: